# Inference backend: "openai" (any OpenAI-compatible server) or "apple"
# (on-device Apple Foundation Model via `fm serve`, macOS 27 only).
LOCALJEV_BACKEND=openai

LOCALJEV_UPSTREAM=http://127.0.0.1:8000
LOCALJEV_UPSTREAM_API_KEY=replace-with-your-local-omlx-key
LOCALJEV_UPSTREAM_MODEL=diffusiongemma-26B-A4B-it-4bit

# Apple Foundation Models instead of oMLX. LocalJev starts and stops `fm serve`
# itself, so no inference server has to be running and no key is needed.
# Requires macOS 27, Apple Intelligence enabled, and an accepted `fm license`.
#
# IMPORTANT: comment out ALL THREE upstream lines above before enabling this.
#   LOCALJEV_UPSTREAM        — while set to anything, the apple backend connects
#                              there instead of spawning `fm serve`.
#   LOCALJEV_UPSTREAM_MODEL  — `diffusiongemma-...` is not a name fm knows; the
#                              apple backend wants `system`, which it defaults to.
#   LOCALJEV_UPSTREAM_API_KEY — unused by fm serve; harmless, but misleading.
# LOCALJEV_BACKEND=apple
# LOCALJEV_FM_BINARY=/usr/bin/fm
#
# Defaults that change automatically on this backend (4096-token context):
# LOCALJEV_UPSTREAM_MODEL=system
# LOCALJEV_MAX_OUTPUT_TOKENS=512
# LOCALJEV_QUESTIONS_PER_CALL=8
# LOCALJEV_OUTCOMES_PER_CALL=32
#
# Set LOCALJEV_UPSTREAM to attach to a `fm serve` you started yourself; LocalJev
# then connects only, and spawns no child process.
# LOCALJEV_UPSTREAM=http://127.0.0.1:1976

# How answer probabilities are obtained. "probability" (default for openai) asks
# the model to report them. "vote" (default for apple, where it measured 52.5%
# against 35.8% macro accuracy) instead makes the model pick one label
# per question, repeats that LOCALJEV_VOTE_SAMPLES times with different seeds,
# and uses the frequencies — better suited to small on-device models, but
# latency multiplies by the sample count and probabilities are quantized to 1/K.
# LOCALJEV_ANSWER_MODE=vote
# LOCALJEV_VOTE_SAMPLES=5
# LOCALJEV_VOTE_TEMPERATURE=1

# Optional: require clients of LocalJev to send this as a Bearer token.
# LOCALJEV_API_KEY=local-dev-key

LOCALJEV_HOST=127.0.0.1
LOCALJEV_PORT=8080
LOCALJEV_TIMEOUT=180
LOCALJEV_MAX_INFLIGHT=2
LOCALJEV_MAX_QUEUE=64
LOCALJEV_MALFORMED_RETRIES=2
LOCALJEV_MAX_OUTPUT_TOKENS=2048
LOCALJEV_QUESTIONS_PER_CALL=16
LOCALJEV_OUTCOMES_PER_CALL=128
